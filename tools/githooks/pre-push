#!/usr/bin/env bash
# Shared REFERENCE pre-push hook (harness repositories). Single source: harness-catalog/tools/githooks/pre-push.
# Each repository keeps a copy in .githooks/pre-push, refreshed with tools/sync-hooks.sh (do not edit copies).
# Refuses the push when a forbidden term appears in: the files of the pushed state, lines added or removed in the
# pushed history, commit messages, or author and committer identities. Also refuses probable secrets.
# NO forbidden pattern is written in this file: the list comes from $FORBIDDEN_TERMS (cloud) or
# ~/.config/personal-repos/forbidden-terms.txt (outside the repository, one extended regex per line, # = comment).
# Repository-specific checks (tests, forbidden data files): .githooks/pre-push.local, if present.
# Enable once per clone: git config core.hooksPath .githooks
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
ZERO=0000000000000000000000000000000000000000
terms=$(mktemp); trap 'rm -f "$terms"' EXIT
LIST="$HOME/.config/personal-repos/forbidden-terms.txt"
if [ -n "${FORBIDDEN_TERMS:-}" ]; then printf '%s\n' "$FORBIDDEN_TERMS" > "$terms"
elif [ -s "$LIST" ]; then cat "$LIST" > "$terms"
else echo "✗ forbidden-terms list missing (FORBIDDEN_TERMS or $LIST): push refused" >&2; exit 1
fi
grep -v -E '^[[:space:]]*(#|$)' "$terms" > "$terms.ok"; mv "$terms.ok" "$terms"
[ -s "$terms" ] || { echo "✗ forbidden-terms list is empty: push refused"; exit 1; }

SECRETS='sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[abp]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(api[_-]?key|secret|token|password)["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9_-]{16,}'
failed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then range=("$local_sha" --not --remotes); else range=("$remote_sha..$local_sha"); fi
  if git grep -n -i -I -E -f "$terms" "$local_sha" -- . ':!.githooks/pre-push' | cut -c1-160 | grep .; then echo "✗ forbidden term in files ($local_ref)"; failed=1; fi
  if git log -p --format='%B' "${range[@]}" -- . ':!.githooks/pre-push' | grep -i -E -f "$terms" | cut -c1-160 | grep .; then echo "✗ forbidden term in history or a commit message"; failed=1; fi
  if git log --format='%an <%ae>%n%cn <%ce>' "${range[@]}" | grep -i -E -f "$terms" | sort -u | grep .; then echo "✗ forbidden author or committer identity"; failed=1; fi
  if git grep -n -i -I -E "$SECRETS" "$local_sha" -- . ':!.githooks/pre-push' | cut -c1-120 | grep .; then echo "✗ probable secret in files"; failed=1; fi
  if git log -p --format= "${range[@]}" -- . ':!.githooks/pre-push' | grep -i -E "$SECRETS" | cut -c1-120 | grep .; then echo "✗ probable secret in history"; failed=1; fi
done
[ $failed -eq 0 ] || { echo "Push refused by the pre-push hook."; exit 1; }
if [ -x .githooks/pre-push.local ]; then .githooks/pre-push.local || { echo "Push refused by .githooks/pre-push.local"; exit 1; }; fi
echo "✓ safety net: nothing sensitive in the pushed commits"
