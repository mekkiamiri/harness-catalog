{
  "mcpServers": {
    "ai-radar": {
      "command": "uv",
      "args": ["run", "--quiet", "--frozen", "--project", "${CLAUDE_PLUGIN_ROOT}", "ai-radar", "mcp"],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "AI_RADAR_GITHUB_TOKEN": "${user_config.github_token}"
      }
    }
  }
}
